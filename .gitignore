# Build artifacts
/bin/
/ahsir
/ahsir-agent

# Plugin per-platform binaries are NO LONGER committed. They were ~20 MB each
# × 4 OS/arch × 2 binaries and exceeded the remote's single-file size limit.
# Instead the plugin ships source in plugin/src/ (vendored) and compiles on the
# user's machine on first use, caching under ~/.cache/ahsir/. The bin/ahsir and
# bin/ahsir-agent wrappers ARE tracked; only the compiled per-platform output is
# ignored in case it's ever produced locally.
/plugin/bin/darwin-amd64/
/plugin/bin/darwin-arm64/
/plugin/bin/linux-amd64/
/plugin/bin/linux-arm64/


# Vendored deps — fetched via `go mod download` instead
/vendor/

# Local agent-tool config — machine-specific (absolute paths, per-user
# settings), generated by the Codex / Claude Code dev loop. The shipped
# plugin manifest lives in .claude-plugin/, which IS tracked.
/.codex/
/.agents/
/.claude/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Runtime state generated by ahsir-agent (contextID → sessionID persistence)
# and per-context transcripts (full conversation content). Auto-recreated on
# first request, contains per-environment ids and conversation data that don't
# belong in version control.
**/.a2a/sessions.json
**/.a2a/transcripts/

# Runtime state generated by the scheduler (invocation ledger).
**/.ahsir/

# Control-plane admin token, generated beside ahsir.yaml at scheduler start.
**/admin-token
